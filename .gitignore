# Go build and module caches redirected into the workspace because the system
# caches are read-only in this sandbox (see launcher/README.md).
.gocache/

# Build outputs
launcher/launcher
launcher/dist/
launcher/dist-SHA256SUMS

# Development shim created by `make run-dev` (see launcher/README.md)
.dev/

# End-to-end test scratch space (the harness in .e2e/run.sh recreates it)
.e2e/state/
.e2e/TestGame/
.e2e/cookies.txt
.e2e/launcher.out

# Test-game fixture build output and its machine-local state
# (`make package` / `make dev` regenerate these; see testgame/README.md).
testgame/dist/
testgame/.state/
testgame/.kobra-dev/

# The publisher toolchain binary
packaging/kobra-pack

# Local games built with this toolchain. Deliberately ignored: each game is its
# own repository, checked out here so the packager, launcher and updater can be
# driven against it in-tree. Nothing under games/ is part of this repo, so
# `git clean -xfd` WILL delete it — remove the -x if you want it kept.
# See "Local games" in AGENTS.md for the layout a game here must follow.
games/
