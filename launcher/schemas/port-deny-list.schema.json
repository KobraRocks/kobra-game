{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kobra.games/schemas/port-deny-list.schema.json",
  "title": "Kobra Port Deny List",
  "description": "Validates port-deny-list.json, the shared deny list consumed by both the launcher and the game shell (spec Section 6.4). Keeping one file prevents the launcher and the browser-side validator from disagreeing about which ports are usable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ranges", "ports", "reserved_ranges", "defaults"],
  "properties": {
    "schema": { "const": "kobra.port-deny-list/1" },
    "description": { "type": "string" },
    "generated": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "ranges": {
      "type": "array",
      "description": "Denied contiguous ranges, lower bound inclusive and upper bound inclusive.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "reason"],
        "properties": {
          "from": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "to": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "reason": { "enum": ["unsafe", "privileged", "ephemeral", "reserved"] },
          "message": { "type": "string" }
        }
      }
    },
    "ports": {
      "type": "array",
      "description": "Individually denied ports.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "reason"],
        "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "reason": { "enum": ["unsafe", "privileged", "ephemeral", "reserved"] },
          "message": { "type": "string" }
        }
      }
    },
    "reserved_ranges": {
      "type": "array",
      "description": "Ranges reserved but not hard-denied; the launcher warns and refuses by default.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "reason"],
        "properties": {
          "from": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "to": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "reason": { "enum": ["unsafe", "privileged", "ephemeral", "reserved"] },
          "message": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "span"],
      "properties": {
        "base": { "type": "integer", "minimum": 1024, "maximum": 49151 },
        "span": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "comment": { "type": "string" }
      }
    }
  }
}
